# DiMer Environment Variables
# Copy this file to .env and fill in your actual credentials

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=xyz.snowflakecomputing.com
SNOWFLAKE_USER=jeipe
SNOWFLAKE_PASSWORD=pass
SNOWFLAKE_DATABASE=TESTDB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_AUTHENTICATOR=snowflake

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=postgres
POSTGRES_SCHEMA=public
POSTGRES_SSL_MODE=prefer

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=mysql
MYSQL_CHARSET=utf8mb4

# BigQuery Configuration
BIGQUERY_PROJECT_ID=your-gcp-project
BIGQUERY_DATASET=your_dataset
BIGQUERY_CREDENTIALS_PATH=/path/to/service-account.json
BIGQUERY_LOCATION=US

# Databricks Configuration
DATABRICKS_HOST=xyz.cloud.databricks.com
DATABRICKS_TOKEN=your_access_token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxyyyysss
DATABRICKS_CATALOG=testdb
DATABRICKS_SCHEMA=default

# DuckDB Configuration
DUCKDB_DATABASE=/path/to/your/database.duckdb
DUCKDB_SCHEMA=main

# CockroachDB Configuration (PostgreSQL wire-compatible)
COCKROACH_HOST=localhost
COCKROACH_PORT=26257
COCKROACH_USER=root
COCKROACH_PASSWORD=your_password
COCKROACH_DATABASE=defaultdb
COCKROACH_SCHEMA=public
COCKROACH_SSL_MODE=prefer

# YugabyteDB Configuration (PostgreSQL fork, YSQL)
YUGABYTE_HOST=localhost
YUGABYTE_PORT=5433
YUGABYTE_USER=yugabyte
YUGABYTE_PASSWORD=your_password
YUGABYTE_DATABASE=yugabyte
YUGABYTE_SCHEMA=public
YUGABYTE_SSL_MODE=prefer

# TiDB Configuration (MySQL wire-compatible)
TIDB_HOST=localhost
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=your_password
TIDB_DATABASE=test
TIDB_CHARSET=utf8mb4

# MongoDB Configuration (document store)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_DATABASE=your_database
MONGODB_AUTH_SOURCE=admin
# Optional: full connection string overrides host/port/user/password
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net

# Redis Configuration (key-value store, KV family)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password
REDIS_DB=0

# Cassandra Configuration (wide-column store, WIDE family)
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=your_password
CASSANDRA_DATABASE=your_keyspace

# Elasticsearch Configuration (search engine, SRCH family)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your_password
ELASTICSEARCH_SCHEME=https
# Optional: API key auth instead of basic auth
# ELASTICSEARCH_API_KEY=your_api_key

# Neo4j Configuration (graph database, GRPH family)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_SCHEME=bolt

# Qdrant Configuration (vector store, VEC family)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_api_key

# InfluxDB Configuration (time-series store, TS family)
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_USER=your_username
INFLUXDB_PASSWORD=your_password
INFLUXDB_DATABASE=your_database

# General Configuration
LOG_LEVEL=INFO
TESTING=false
METRICS_ENABLED=true
CONNECTION_TIMEOUT=300
QUERY_TIMEOUT=600
MAX_RETRIES=3

# Performance Tuning
DEFAULT_POOL_SIZE=5
MAX_POOL_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600